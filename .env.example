# TraceBook configuration — copy to .env and fill in. .env is never committed.
#
# The extract step uses an OpenAI-compatible chat completion endpoint.
# Verify / report / rot-check are fully deterministic and need no keys.
#
# IMPORTANT: placeholder values are refused. The extractor exits with an
# error and makes ZERO network calls until real values are present.

# Model slot (OpenAI-compatible chat completions)
MODEL_A_BASE_URL=YOUR_BASE_URL_HERE
MODEL_A_API_KEY=YOUR_API_KEY_HERE
MODEL_A_NAME=YOUR_MODEL_NAME_HERE

# Optional: request timeout in milliseconds (default 120000)
MODEL_A_TIMEOUT_MS=120000
